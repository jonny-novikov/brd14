# brd14.dict — libFuzzer dictionary (-dict) for the brd14 fuzz targets:
# the format's literals, the range edges, and the bytes just outside each
# alphabet run (where an off-by-one in a range mask would show).
id_v1="USR0KHTOWnGLuC"
id_v2="USR0NgWEfAEJfs"
ns_usr="USR"
ns_zzz="ZZZ"
ns_lower="usr"
payload_max="AzL8n0Y58m7"
payload_max_plus_1="AzL8n0Y58m8"
payload_zero="00000000000"
payload_top="zzzzzzzzzzz"
qa_hi="AzL8n"
c_0="0"
c_9="9"
c_A="A"
c_Z="Z"
c_a="a"
c_z="z"
below_0="/"
above_9=":"
below_A="@"
above_Z="["
below_a="`"
above_z="{"
high_bit="\x80"
all_ones="\xff"
u64_le_max_snow="\xff\xff\xff\xff\xff\xff\xff\x7f"
u64_le_2p63="\x00\x00\x00\x00\x00\x00\x00\x80"
u64_le_max="\xff\xff\xff\xff\xff\xff\xff\xff"
u64_le_62p6="\x40\xd0\x8e\x39\x0d\x00\x00\x00"
