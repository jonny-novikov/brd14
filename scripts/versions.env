# versions.env — the pinned toolchain set for brd14. One file, sourced by
# scripts/setup.sh, scripts/env.sh and mirrored by .github/workflows/ci.yml.
# Bump here first; everything else reads these names.
GO_VERSION=1.26.9          # dev + CI toolchain (fetched via GOTOOLCHAIN)
GO_FLOOR_VERSION=1.22.12   # the go.mod floor, exercised by the full tier
PYTHON_VERSION=3.14        # deadsnakes: python3.14 + python3.14-nogil (3.14t)
NODE_VERSION=24.21.0       # latest LTS ("Krypton")
BUN_VERSION=1.4.3
RUST_VERSION=1.99.0        # also pinned in native/rust/rust-toolchain.toml
OTP_VERSION=25.3           # Ubuntu 24.04 erlang-nox (25.3.2.x); the floor ex/echo_data supports
ELIXIR_VERSION=1.14.0      # Ubuntu 24.04 elixir; ex/echo_data requires ~> 1.14
