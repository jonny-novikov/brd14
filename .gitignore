# --- generic
.env
.idea/
.vscode/
.DS_Store
*.out
coverage.*
*.coverprofile
profile.cov

# --- go
*.test
go.work
go.work.sum

# --- c / native
build/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.exe~
priv/
native/c/fuzz/corpus/
native/c/fuzz/crash-*

# --- rust
native/rust/target/
native/rust/fuzz/target/
native/rust/fuzz/corpus/
native/rust/fuzz/artifacts/

# --- python
__pycache__/
*.py[cod]
.venv*/
*.egg-info/
.pytest_cache/
dist/

# --- typescript / js
node_modules/
ts/**/dist/
ts/packages/brd14-wasm/src/wasm-bytes.ts
*.tsbuildinfo

# --- agent worktrees (isolated parallel builds; never committed)
.claude/worktrees/

# --- elixir (ex/)
ex/**/_build/
ex/**/deps/
ex/**/*.ez
ex/**/erl_crash.dump
ex/**/native/**/target/
# echo_data keeps data files in priv/ (the census vectors); only built NIFs are ignored there
!ex/echo_data/priv/
ex/echo_data/priv/*.so
